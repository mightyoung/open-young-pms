# PMS Backend Environment Variables
# Copy this file to .env and fill in the values

# Database (PostgreSQL only — no SQLite fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/pms_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Secret (REQUIRED — must be set in production, min 32 chars)
JWT_SECRET=change-me-in-production

# AI Services (通义千问)
DASHSCOPE_API_KEY=your_api_key_here

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=104857600

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
