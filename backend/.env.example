# ============================================================
# PMS Backend - 环境配置
# ============================================================

# ==================== 应用配置 ====================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ==================== PostgreSQL ====================
# PostgreSQL connection string (async driver: postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pms_db

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0

# ==================== JWT / 安全 ====================
# REQUIRED: Set a strong secret in production (min 32 chars)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ==================== CORS ====================
# Comma-separated list of allowed origins (no wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== AI / LLM ====================
DASHSCOPE_API_KEY=your_api_key_here

# ==================== 文件存储 ====================
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ==================== 随手拍配置 ====================
HAZARD_AUTO_ASSIGN_ENABLED=true
HAZARD_DUPLICATE_CHECK_ENABLED=true
HAZARD_DUPLICATE_DISTANCE_METERS=50
HAZARD_DUPLICATE_TIME_WINDOW_HOURS=24
HAZARD_DRAFT_RETENTION_DAYS=7
